{
  "name": "reading-tracker-app-spa",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.ts --root-types --root-types-no-schema-prefix --enum-values"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "marked": "^18.0.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.7.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.4"
  }
}
